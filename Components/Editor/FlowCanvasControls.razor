@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<div class="d-inline-block absolute"
     style="top: 0.25rem; left: 0.25rem; z-index: 2; max-width: calc(100% - 0.5rem);">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
        <MudFileUpload T="IBrowserFile"
                       FilesChanged="OnFlowFileSelected"
                       Accept=".json"
                       Class="d-inline-flex">
            <SelectedTemplate Context="_" />
            <CustomContent>
                <MudButton StartIcon="@Icons.Material.Filled.Upload"
                           Variant="@Variant.Filled"
                           Color="@Color.Primary"
                           OnClick="@context.OpenFilePickerAsync">
                    Load Flow
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudButton StartIcon="@Icons.Material.Filled.Download"
                   Variant="@Variant.Filled"
                   Color="@Color.Primary"
                   OnClick="() => OnSaveFlow.InvokeAsync(false)">
            Save Flow
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Download"
                   Variant="@Variant.Filled"
                   Color="@Color.Primary"
                   OnClick="() => OnSaveFlow.InvokeAsync(true)">
            Export as Mermaid Flow
        </MudButton>
        <MudButton
            StartIcon="@(ClearButtonDisabled ? Icons.Material.Filled.Delete : Icons.Material.Filled.DeleteForever)"
            Variant="@Variant.Filled"
            Color="@(ClearButtonDisabled ? Color.Warning : Color.Error)"
            OnClick="OnClearButtonClicked">
            @(ClearButtonDisabled ? "Clear Flow" : "Confirm Clear")
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.StopCircle"
                   Variant="@Variant.Filled"
                   Color="@Color.Error"
                   Disabled="@(!CanTerminateSession)"
                   title="Terminate all running processes and purge flow session"
                   OnClick="OnTerminateSession">
            Terminate Session
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.PlayCircle"
                   Variant="@Variant.Filled"
                   Color="@Color.Success"
                   Disabled="@(!CanExecuteFlow)"
                   title="@ExecuteFlowButtonTitle"
                   OnClick="OnExecuteFlow">
            Execute flow
        </MudButton>
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired] public bool ClearButtonDisabled { get; set; } = true;
    [Parameter, EditorRequired] public bool CanTerminateSession { get; set; }
    [Parameter, EditorRequired] public bool CanExecuteFlow { get; set; }
    [Parameter, EditorRequired] public string ExecuteFlowButtonTitle { get; set; } = "Execute flow";

    [Parameter, EditorRequired] public EventCallback<IBrowserFile> OnFlowFileSelected { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> OnSaveFlow { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClearButtonClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback OnTerminateSession { get; set; }
    [Parameter, EditorRequired] public EventCallback OnExecuteFlow { get; set; }
}
