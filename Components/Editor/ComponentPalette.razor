@using System.Collections.Immutable
@using BlazorDrawFBP.Services
@using Mas.Schema.Fbp
@using MudBlazor

<MudPaper Outlined="true"
          Class="d-flex flex-column flex-shrink-0 overflow-hidden pb-2 gap-1"
          Style="width: 24rem; min-height: 0;">
    <MudTextField @bind-Value="@_searchText"
                  Placeholder="Search components"
                  Variant="Variant.Text"
                  Margin="Margin.Dense"
                  Class="flex-grow-0 mt-0 mb-0 px-2 pt-2"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  DebounceInterval="300"
                  OnDebounceIntervalElapsed="ApplyComponentSearch"
                  Clearable="true"
                  OnClearButtonClick="ClearComponentSearch"
                  ClearIcon="@Icons.Material.Filled.Close"/>
    <MudNavMenu Dense="true"
                Class="components-list d-flex flex-column gap-1 flex-grow-1 overflow-auto">
        @{
            var categoryIds = SortedCatIds
                .Where(CategoryVisibleInComponentList)
                .ToList();
        }
        @for (var i = 0; i < categoryIds.Count; i++)
        {
            var catId = categoryIds[i];
            var compIds = RuntimeService.CatId2CompServiceIdAndComponentIds[catId];
            var isExpanded = IsCategoryExpanded(catId);
            var categoryMatchesSearch = CategoryMatchesSearch(catId);

            <MudNavGroup @key="catId"
                         Expanded="@isExpanded"
                         ExpandedChanged="@((bool expanded) => SetCategoryExpanded(catId, expanded))"
                         ExpandIcon="@Icons.Material.Filled.ExpandMore"
                         HeaderClass="rounded pa-1"
                         Ripple="false">
                <TitleContent>
                    <MudText Class="ml-n3">@RuntimeService.CatId2Info[catId].Name</MudText>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="1" Class="gap-1 pt-1">
                        @foreach (var compId in compIds)
                        {
                            if (!RuntimeService.ServiceIdAndComponentId2Component.TryGetValue(compId, out var comp)) continue;
                            if (comp.Type == Component.ComponentType.subflow) continue;

                            if (SearchActive && !categoryMatchesSearch && !ComponentMatchesSearch(comp))
                            {
                                continue;
                            }

                            var serviceName = RuntimeService.GetComponentServiceName(compId.Item1);
                            var serviceHandleStyle = RuntimeService.GetComponentServiceHandleStyle(compId.Item1);

                            RenderFragment componentItem = @<MudPaper Class="component-palette-item cursor-grab d-flex align-center rounded pa-2 gap-2 mud-width-full"
                                                                      draggable="true"
                                                                      @ondragstart="() => OnComponentDragStart.InvokeAsync((comp, compId.Item1))"
                                                                      @ondragend="OnComponentDragEnd"
                                                                      Outlined="true"
                                                                      Elevation="0"
                                                                      title="@comp.Info.Name"
                                                                      role="button"
                                                                      tabindex="0">
                                                                <span class="component-service-handle d-inline-flex align-center justify-start flex-shrink-0 overflow-hidden rounded pa-1"
                                                                      style="@serviceHandleStyle"
                                                                      title="@serviceName"
                                                                      aria-label="@serviceName"
                                                                      tabindex="0">
                                                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"/>
                                                                    <span class="component-service-handle-label d-inline-flex align-center overflow-hidden mud-typography-caption"
                                                                          style="line-height: 1; text-overflow: ellipsis; white-space: nowrap;">
                                                                        @serviceName
                                                                    </span>
                                                                </span>
                                                                <MudText Typo="Typo.body2"
                                                                         Class="overflow-hidden mud-width-full"
                                                                         Style="text-align: left; text-overflow: ellipsis; white-space: nowrap;">
                                                                    @comp.Info.Name
                                                                </MudText>
                                                            </MudPaper>;

                            if (string.IsNullOrEmpty(comp.Info.Description))
                            {
                                <div @key="compId" class="mud-width-full">
                                    @componentItem
                                </div>
                            }
                            else
                            {
                                <MudTooltip @key="compId">
                                    <ChildContent>
                                        @componentItem
                                    </ChildContent>
                                    <TooltipContent>
                                        <MudText Typo="Typo.body2">@comp.Info.Description</MudText>
                                    </TooltipContent>
                                </MudTooltip>
                            }
                        }
                    </MudStack>
                </ChildContent>
            </MudNavGroup>
        }
    </MudNavMenu>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IFbpRuntimeService RuntimeService { get; set; } = null!;
    [Parameter] public EventCallback<(Component Component, string ServiceId)> OnComponentDragStart { get; set; }
    [Parameter] public EventCallback OnComponentDragEnd { get; set; }

    private string _searchText = "";
    private string _query = "";
    private const int MinSearchChars = 3;
    private const string DefaultCatId = "default";
    private readonly Dictionary<string, bool> _expandedPanels = new() { { DefaultCatId, true } };

    private IEnumerable<string> SortedCatIds => new List<string> { DefaultCatId }
        .Concat(RuntimeService.CatId2CompServiceIdAndComponentIds.Keys
            .Where(catId => catId != DefaultCatId)
            .ToImmutableSortedSet()
            .AsEnumerable());

    private bool SearchActive => _query.Length >= MinSearchChars;

    private bool IsCategoryExpanded(string catId) =>
        SearchActive
            ? CategoryHasMatchingComponent(catId)
            : _expandedPanels.GetValueOrDefault(catId, false);

    private bool CategoryVisibleInComponentList(string catId) =>
        RuntimeService.CatId2CompServiceIdAndComponentIds.TryGetValue(catId, out var compIds) &&
        compIds.Any(compId =>
            RuntimeService.ServiceIdAndComponentId2Component.TryGetValue(compId, out var comp) &&
            comp.Type != Component.ComponentType.subflow &&
            (!SearchActive || CategoryMatchesSearch(catId) || ComponentMatchesSearch(comp)));

    private Task ApplyComponentSearch(string searchText)
    {
        _searchText = searchText ?? "";
        var trimmedSearchText = _searchText.Trim();
        _query = trimmedSearchText.Length >= MinSearchChars ? trimmedSearchText : "";
        return Task.CompletedTask;
    }

    private void ClearComponentSearch()
    {
        _searchText = "";
        _query = "";
    }

    private bool CategoryHasMatchingComponent(string catId) =>
        CategoryMatchesSearch(catId) ||
        RuntimeService.CatId2CompServiceIdAndComponentIds.TryGetValue(catId, out var compIds) &&
        compIds.Any(compId =>
            RuntimeService.ServiceIdAndComponentId2Component.TryGetValue(compId, out var comp) &&
            comp.Type != Component.ComponentType.subflow &&
            ComponentMatchesSearch(comp));

    private bool CategoryMatchesSearch(string catId)
    {
        if (!SearchActive)
        {
            return true;
        }

        if (!RuntimeService.CatId2Info.TryGetValue(catId, out var info))
        {
            return catId.Contains(_query, StringComparison.OrdinalIgnoreCase);
        }

        return info.Id.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
               (info.Name?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (info.Description?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool ComponentMatchesSearch(Component comp)
    {
        if (!SearchActive)
        {
            return true;
        }

        return (comp.Info.Name?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (comp.Info.Description?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void SetCategoryExpanded(string catId, bool expanded)
    {
        if (SearchActive)
        {
            return;
        }

        _expandedPanels[catId] = expanded;
    }
}
