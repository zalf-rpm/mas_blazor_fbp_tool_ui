@inject IAppThemeService ThemeService
@using BlazorDrawFBP.Services
@implements IDisposable

<MudPaper Outlined="true">
    <MudToolBar Dense="true" Class="px-2">
        <MudIconButton Icon="@(ComponentListVisible ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       title="@(ComponentListVisible ? "Hide components" : "Show components")"
                       OnClick="@OnToggleComponentList"/>
        <MudImage Class="ml-1 mr-1" Src="img/ocapi_just_logo.png" Height="45"/>
        <MudText Typo="Typo.h4">OCAPI-Flow Tool</MudText>
        @if (FlowId.HasValue)
        {
            <MudTooltip Text="Click to copy flow URL">
                <MudChip T="string"
                         Icon="@Icons.Material.Filled.Share"
                         Variant="Variant.Outlined"
                         Color="Color.Primary"
                         Size="Size.Small"
                         Class="ml-3 cursor-pointer"
                         OnClick="@OnCopyFlowUrl">
                    Flow: @ShortFlowId
                </MudChip>
            </MudTooltip>
            <MudTooltip Text="Session detached TTL (click to cycle: 15m, 30m, 2h, 24h)">
                <MudChip T="string"
                         Icon="@Icons.Material.Filled.Timer"
                         Variant="Variant.Outlined"
                         Color="Color.Secondary"
                         Size="Size.Small"
                         Class="ml-1 cursor-pointer"
                         OnClick="@OnCycleTtl">
                    TTL: @TtlLabel
                </MudChip>
            </MudTooltip>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Class="ml-2"
                   OnClick="@OnCreateNewFlow">
            New Flow
        </MudButton>
        <MudSpacer/>
        <MudButtonGroup Variant="Variant.Filled" Color="Color.Inherit">
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OnAddComponentService">
                Components
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OnAddChannelService">
                Channels
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Settings"
                       OnClick="@OnShowSturdyRefDialog">
                Edit SturdyRefs
            </MudButton>
        </MudButtonGroup>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                 Color="Color.Inherit"
                 Dense="true"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 AriaLabel="Settings">
            <MudText Typo="Typo.caption" Class="px-4 py-1 mud-text-secondary">Theme</MudText>
            <MudMenuItem Icon="@Icons.Material.Filled.LightMode"
                         IconColor="@(!ThemeService.IsDarkMode ? Color.Primary : Color.Default)"
                         OnClick="@(() => ThemeService.SetDarkModeAsync(false))">
                <div class="d-flex align-center justify-space-between mud-width-full">
                    <span>Light theme</span>
                    @if (!ThemeService.IsDarkMode)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" Class="ml-2"/>
                    }
                </div>
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DarkMode"
                         IconColor="@(ThemeService.IsDarkMode ? Color.Primary : Color.Default)"
                         OnClick="@(() => ThemeService.SetDarkModeAsync(true))">
                <div class="d-flex align-center justify-space-between mud-width-full">
                    <span>Dark theme</span>
                    @if (ThemeService.IsDarkMode)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" Class="ml-2"/>
                    }
                </div>
            </MudMenuItem>
        </MudMenu>
    </MudToolBar>
</MudPaper>

@code {
    [Parameter] [EditorRequired] public bool ComponentListVisible { get; set; } = true;
    [Parameter] public Guid? FlowId { get; set; }
    [Parameter] [EditorRequired] public string ShortFlowId { get; set; } = "";
    [Parameter] [EditorRequired] public string TtlLabel { get; set; } = "30m";

    [Parameter] [EditorRequired] public EventCallback OnToggleComponentList { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnCopyFlowUrl { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnCycleTtl { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnCreateNewFlow { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnAddComponentService { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnAddChannelService { get; set; }
    [Parameter] [EditorRequired] public EventCallback OnShowSturdyRefDialog { get; set; }

    protected override void OnInitialized()
    {
        if (ThemeService != null)
        {
            ThemeService.ThemeChanged += OnThemeChanged;
        }
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (ThemeService != null)
        {
            ThemeService.ThemeChanged -= OnThemeChanged;
        }
    }

}