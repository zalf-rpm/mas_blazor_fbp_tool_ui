@using BlazorDrawFBP.Data
@using BlazorDrawFBP.Services
@using Blazored.LocalStorage
@using MudBlazor
@implements IDisposable

@inject ISnackbar Snackbar
@inject ILocalStorageService LocalStorage
@inject IBookmarkConnectionService Bookmarks
@inject IDialogService DialogService

<MudDialog ContentClass="overflow-hidden d-flex flex-column"
           ActionsClass="px-6 py-2">
    <TitleContent>
        <MudText Typo="Typo.h6">Sturdy reference bookmarks</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2" Class="mud-width-full">
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="flex-shrink-0">
                Stored sturdy references live in this browser and can be reused for registries,
                channel services, and other persistent capabilities.
            </MudAlert>

            <MudStack Row="true"
                      Wrap="Wrap.Wrap"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Spacing="2"
                      Class="flex-shrink-0">
                <MudTextField T="string"
                              @bind-Value="_searchText"
                              Placeholder="Search bookmarks"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              DebounceInterval="300"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              Class="flex-grow-1"/>

                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="@AddBookmarkAsync">
                    Add bookmark
                </MudButton>
            </MudStack>

            @if (_loadingBookmarks)
            {
                <MudPaper Outlined="true" Class="d-flex justify-center align-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
                </MudPaper>
            }
            else
            {
                <MudTable T="StoredSrData"
                          Items="@FilteredBookmarks"
                          Hover="true"
                          Dense="true"
                          Breakpoint="Breakpoint.Md"
                          FixedHeader="true"
                          Height="58vh"
                          Elevation="0"
                          Class="mud-width-full">
                    <ColGroup>
                        <col style="width: 20%;"/>
                        <col style="width: 16%;"/>
                        <col/>
                        <col style="width: 7.5rem;"/>
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>Bookmark</MudTh>
                        <MudTh>Behavior</MudTh>
                        <MudTh>Sturdy reference</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Bookmark">
                            @if (IsEditing(context))
                            {
                                <MudStack Spacing="1">
                                    <MudTextField @bind-Value="_editingBookmark.PetName"
                                                  Label="Pet name"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Clearable="true"
                                                  Immediate="true"/>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FormatInterfaceId(context.InterfaceId)
                                    </MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@DisplayPetName(context)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FormatInterfaceId(context.InterfaceId)
                                    </MudText>
                                </MudStack>
                            }
                        </MudTd>
                        <MudTd DataLabel="Behavior">
                            @if (IsEditing(context))
                            {
                                <MudStack Spacing="0">
                                    <MudSwitch @bind-Value="_editingBookmark.AutoConnect"
                                               Label="Auto connect"
                                               Color="@Color.Primary"/>
                                    <MudSwitch @bind-Value="_editingBookmark.DefaultSelect"
                                               Label="Default"
                                               Color="@Color.Primary"/>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Outlined"
                                             Color="@(context.AutoConnect ? Color.Primary : Color.Default)">
                                        @(context.AutoConnect ? "Auto connect" : "Manual")
                                    </MudChip>
                                    @if (context.DefaultSelect)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Color="Color.Secondary">
                                            Default
                                        </MudChip>
                                    }
                                </MudStack>
                            }
                        </MudTd>
                        <MudTd DataLabel="Sturdy reference" Style="max-width: 32rem;">
                            @if (IsEditing(context))
                            {
                                <MudTextField @bind-Value="_editingBookmark.SturdyRef"
                                              Label="Sturdy reference"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Lines="3"/>
                            }
                            else
                            {
                                <MudTooltip Text="@context.SturdyRef">
                                    <MudText Typo="Typo.body2" Style="word-break: break-all;">
                                        @context.SturdyRef
                                    </MudText>
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true"
                                      Wrap="Wrap.NoWrap"
                                      Spacing="0"
                                      Justify="Justify.FlexEnd"
                                      AlignItems="AlignItems.Center"
                                      Style="width: 7.5rem;">
                                @if (IsEditing(context))
                                {
                                    <MudTooltip Text="Save bookmark">
                                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                       Color="Color.Primary"
                                                       Disabled="@(!CanSaveEditingBookmark)"
                                                       OnClick="@SaveEditingBookmarkAsync"/>
                                    </MudTooltip>

                                    <MudTooltip Text="Cancel editing">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       OnClick="@CancelEditingBookmark"/>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <div class="d-flex align-center justify-center" style="width: 40px; min-width: 40px;">
                                        @if (IsBusy(context))
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="@ResolveConnectTooltip(context)">
                                                <span>
                                                    <MudIconButton Icon="@(IsConnected(context) ? Icons.Material.Filled.LinkOff : Icons.Material.Filled.Cast)"
                                                                   Color="@(IsConnected(context) ? Color.Success : Color.Default)"
                                                                   Disabled="@(!CanToggleConnection(context))"
                                                                   OnClick="@(() => ToggleConnectionAsync(context))"/>
                                                </span>
                                            </MudTooltip>
                                        }
                                    </div>

                                    <MudTooltip Text="Edit bookmark">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       OnClick="@(() => BeginEditing(context))"/>
                                    </MudTooltip>

                                    <MudTooltip Text="Delete bookmark">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick="@(() => Delete(context))"/>
                                    </MudTooltip>
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4" Color="Color.Secondary">
                            @(_searchText.Length > 0
                                ? "No bookmarks match your search."
                                : "No sturdy references saved yet.")
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-auto">
            @BookmarkCountLabel
        </MudText>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public IFbpRuntimeService Runtime { get; set; } = null!;

    private List<StoredSrData> _bookmarks = [];
    private string _searchText = "";
    private bool _loadingBookmarks = true;
    private readonly HashSet<StoredSrData> _busyBookmarks = [];
    private StoredSrData? _editingBookmarkSource;
    private StoredSrData _editingBookmark = new();

    private List<StoredSrData> FilteredBookmarks =>
        _bookmarks.Where(MatchesSearch).ToList();

    private string BookmarkCountLabel =>
        $"{FilteredBookmarks.Count} of {_bookmarks.Count} bookmark(s)";

    private bool CanSaveEditingBookmark =>
        !string.IsNullOrWhiteSpace(_editingBookmark.SturdyRef);

    protected override void OnInitialized()
    {
        // connections also change without us (auto-connect, dropped services, other dialogs)
        Runtime.StateChanged += OnRuntimeStateChanged;
    }

    public void Dispose()
    {
        Runtime.StateChanged -= OnRuntimeStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadBookmarksAsync();
    }

    private void OnRuntimeStateChanged()
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { } // dialog was closed meanwhile
    }

    private async Task LoadBookmarksAsync()
    {
        try
        {
            _bookmarks = await StoredSrData.GetAllData(LocalStorage);
            _bookmarks.Sort();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't read the stored bookmarks: {ex.Message}", Severity.Error);
            _bookmarks = [];
        }

        _loadingBookmarks = false;
        await RefreshAsync();
    }

    private Task PersistBookmarksAsync()
    {
        return StoredSrData.SaveAllData(LocalStorage, _bookmarks);
    }

    private bool IsConnected(StoredSrData data) => Runtime.IsConnected(data.SturdyRef);

    private bool IsBusy(StoredSrData data) => _busyBookmarks.Contains(data);

    private bool CanToggleConnection(StoredSrData data)
    {
        return !IsBusy(data)
               && !string.IsNullOrWhiteSpace(data.SturdyRef)
               && (IsConnected(data) || CanResolveInterface(data));
    }

    private bool CanResolveInterface(StoredSrData data)
    {
        return data.InterfaceId != 0 && Runtime.InterfaceIdToType.ContainsKey(data.InterfaceId);
    }

    private async Task ToggleConnectionAsync(StoredSrData data)
    {
        if (!CanToggleConnection(data))
            return;

        _busyBookmarks.Add(data);
        await RefreshAsync();
        try
        {
            if (IsConnected(data))
            {
                Bookmarks.Disconnect(Runtime, data);
                Snackbar.Add($"Disconnected from '{DisplayPetName(data)}'.", Severity.Info);
            }
            else if (await Bookmarks.ConnectAsync(Runtime, data))
            {
                Snackbar.Add($"Connected to '{DisplayPetName(data)}'.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Couldn't connect to '{DisplayPetName(data)}'.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"'{DisplayPetName(data)}': {ex.Message}", Severity.Error);
        }
        finally
        {
            _busyBookmarks.Remove(data);
            await RefreshAsync();
        }
    }

    private async Task AddBookmarkAsync()
    {
        var parameters = new DialogParameters<NewSturdyRefDialog>
        {
            { x => x.InterfaceId, 0UL },
            { x => x.AllowInterfaceIdEdit, true }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NewSturdyRefDialog>("Add sturdy reference", parameters, options);
        var bookmark = await dialog.GetReturnValueAsync<StoredSrData>();
        if (bookmark is null)
            return;

        await UpsertBookmarkAsync(null, bookmark);
    }

    private void BeginEditing(StoredSrData data)
    {
        _editingBookmarkSource = data;
        _editingBookmark = data.Clone();
    }

    private bool IsEditing(StoredSrData data)
    {
        return ReferenceEquals(_editingBookmarkSource, data);
    }

    private void CancelEditingBookmark()
    {
        _editingBookmarkSource = null;
        _editingBookmark = new StoredSrData();
    }

    private async Task SaveEditingBookmarkAsync()
    {
        if (_editingBookmarkSource == null)
            return;

        var bookmark = _editingBookmark.Clone();
        bookmark.PetName = bookmark.PetName?.Trim() ?? "";
        bookmark.SturdyRef = bookmark.SturdyRef?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(bookmark.SturdyRef))
        {
            Snackbar.Add("Enter a sturdy reference.", Severity.Error);
            return;
        }

        var existing = _editingBookmarkSource;
        CancelEditingBookmark();
        await UpsertBookmarkAsync(existing, bookmark);
    }

    private async Task UpsertBookmarkAsync(StoredSrData? existing, StoredSrData bookmark)
    {
        var pointsElsewhere =
            existing != null
            && (existing.InterfaceId != bookmark.InterfaceId
                || !string.Equals(existing.SturdyRef, bookmark.SturdyRef, StringComparison.Ordinal));
        var reconnect = false;
        if (pointsElsewhere)
        {
            bookmark.ServiceId = ""; // another service now; learned again on connect
            reconnect = IsConnected(existing!);
            if (reconnect)
                Runtime.DisconnectBookmark(existing!.InterfaceId, existing.SturdyRef);
            Bookmarks.ForgetManualDisconnect(existing!);
        }

        if (bookmark.DefaultSelect)
            foreach (var entry in _bookmarks.Where(entry => entry.InterfaceId == bookmark.InterfaceId))
                entry.DefaultSelect = false;

        if (existing == null)
        {
            _bookmarks.Add(bookmark);
            Snackbar.Add("Bookmark added.", Severity.Success);
        }
        else
        {
            var index = _bookmarks.IndexOf(existing);
            if (index >= 0)
                _bookmarks[index] = bookmark;
            Snackbar.Add("Bookmark updated.", Severity.Success);
        }

        _bookmarks.Sort();
        await PersistBookmarksAsync();
        await RefreshAsync();

        if (reconnect)
            await ToggleConnectionAsync(bookmark);
    }

    private async Task Delete(StoredSrData data)
    {
        if (ReferenceEquals(_editingBookmarkSource, data))
            CancelEditingBookmark();

        if (!_bookmarks.Remove(data))
            return;

        Bookmarks.ForgetManualDisconnect(data);
        await PersistBookmarksAsync();
        Snackbar.Add("Bookmark removed.", Severity.Info);
        await RefreshAsync();
    }

    private bool MatchesSearch(StoredSrData data)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var search = _searchText.Trim();
        return DisplayPetName(data).Contains(search, StringComparison.OrdinalIgnoreCase)
               || data.SturdyRef.Contains(search, StringComparison.OrdinalIgnoreCase)
               || FormatInterfaceId(data.InterfaceId).Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayPetName(StoredSrData data)
    {
        return string.IsNullOrWhiteSpace(data.PetName) ? "(Unnamed bookmark)" : data.PetName;
    }

    private static string FormatInterfaceId(ulong interfaceId)
    {
        return interfaceId == 0 ? "Missing interface ID" : $"0x{interfaceId:x16}";
    }

    private string ResolveConnectTooltip(StoredSrData data)
    {
        if (IsConnected(data))
            return "Disconnect";
        if (IsBusy(data))
            return "Working...";
        if (!CanResolveInterface(data))
            return "This interface isn't available in the current editor session.";
        return "Connect";
    }
}
