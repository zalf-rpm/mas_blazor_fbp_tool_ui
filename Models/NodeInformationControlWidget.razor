@using Blazor.Diagrams.Core.Models.Base;
@using BlazorDrawFBP.Models;;

<MudPaper Elevation="0" Class="mud-background-gray pa-2 rounded" Style="@($"width: {Node.Size!.Width}px;")">
    @if (Model is NodeModel)
    {
        <MudText Typo="Typo.caption" Class="d-block">Width: @Node.Size.Width</MudText>
        <MudText Typo="Typo.caption" Class="d-block">Height: @Node.Size.Height</MudText>
        <MudText Typo="Typo.caption" Class="d-block">Ports: @Node.Ports.Count</MudText>
        <MudText Typo="Typo.caption" Class="d-block">Links: @(Node.Links.Count + Node.PortLinks.Count())</MudText>
    }
    else if (Model is LinkModel)
    {
        <MudText Typo="Typo.caption" Class="d-block">Width: @Link.Width</MudText>
        <MudText Typo="Typo.caption" Class="d-block">Color: @Link.Color</MudText>
        <MudText Typo="Typo.caption" Class="d-block">LLabel: @Link.Labels[0].Content</MudText>
        <MudText Typo="Typo.caption" Class="d-block">RLabel: @Link.Labels[2].Content</MudText>
    }
</MudPaper>

@code
{
    [Parameter, EditorRequired]
    public NodeInformationControl Control { get; set; } = null!;

    [Parameter, EditorRequired]
    public Model Model { get; set; } = null!;

    public NodeModel Node => (Model as NodeModel)!;
    public LinkModel Link => (Model as LinkModel)!;
}
