@using BlazorDrawFBP.Renderers
@using Mas.Infrastructure.BlazorComponents
@using Mas.Infrastructure.Common
@using Mas.Schema.Common
@inject IDialogService DialogService
@inject ConnectionManager ConMan
@* @inject BlazorDispatcher Dispatcher *@

<div>
    <MudPaper Style="@CardStyle" Class="position-relative overflow-visible d-flex flex-column align-content-space-between activity-state-frame"
              Elevation="0">
        <CapnpFbpLifecycleIndicator State="@Node.DisplayLifecycleState"
                                    Label="@Node.LifecycleLabel"
                                    Error="@Node.LifecycleError"/>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pl-3 pr-3 pt-3">
            <MudButton Color="@Color.Primary"
                       Disabled="@Node.IsLifecycleBusy"
                       StartIcon="@LifecycleButtonIcon"
                       OnClick="@SendIip">
                @LifecycleButtonText
            </MudButton>
            <MudButton Color="@Color.Primary"
                       EndIcon="@Icons.Material.Filled.OpenInNew"
                       OnClick="@ShowDetails">
                Large
            </MudButton>
        </MudStack>
        <MudGrid Justify="Justify.Center" Spacing="1">
            <MudItem Class="pt-0" xs="12">
                <div @onpointerenter="@(_ => { Node.Locked = true; })"
                     @onpointerleave="@(_ => { Node.Locked = false; })">
                    <MudSelect T="(bool, StructuredText.Type)"
                               Class="pl-3 pr-3"
                               @bind-Value="Node.PlainTextOrContentType"
                               Margin="Margin.Dense"
                               Variant="Variant.Text">
                        <MudSelectItem Value="@((true, StructuredText.Type.unstructured))">
                            as plain text
                        </MudSelectItem>
                        @foreach (var ct in Enum.GetValues<StructuredText.Type>())
                        {
                            <MudSelectItem Value="@((false, ct))">@(Shared.FormatStructuredTextType(ct))</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </MudItem>
            <MudItem xs="12"
                     @onpointerenter="@(_ => DisableZoom())"
                     @onpointerleave="@(_ => EnableZoom())">
                <MudTextField Class="pl-3 pr-3" Style="margin-top: -6px;"
                              T="string"
                              @bind-Value="Node.Content"
                              Lines="3"
                              Label="IIP content"
                              Variant="Variant.Outlined"
                              @onpointerenter="@(_ => Node.Locked = true)"
                              @onpointerleave="@(_ => Node.Locked = false)"/>
            </MudItem>
        </MudGrid>
    </MudPaper>
    <MudText Style="@CardToolTipStyle" Typo="Typo.subtitle1" Align="Align.Center">
        @CardToolTipText
    </MudText>

    @foreach (var port in Node.Ports)
    {
        if (port is not CapnpFbpOutPortModel iipPort) continue;
        <div @onmouseenter="@(() => CardToolTipText = Shared.MakePortToolTipText(iipPort))"
             @onmouseleave="@(() => CardToolTipText = new MarkupString())">
            <CapnpFbpPortRenderer @key="iipPort"
                                  Port="iipPort"
                                  SocketColor="@GetSocketColor(iipPort)"/>
        </div>
    }
</div>

@code
{
    [Parameter] [EditorRequired] public CapnpFbpIipComponentModel Node { get; set; } = null!;

    private string CardStyle => $"height: {Shared.CardHeight}px; width: {Shared.CardWidth}px;{FrameWidth};{FrameColor}";
    private const string FrameWidth = "border-width: 1px";

    private string FrameBorderColorValue =>
        CapnpFbpPortColors.ResolveLifecycleFrameColor(Node.DisplayLifecycleState);

    private string FrameColor => $@"border-color: {FrameBorderColorValue}";

    private string GetSocketColor(CapnpFbpPortModel port)
    {
        return CapnpFbpPortColors.ResolvePortShellColor(port) ?? FrameBorderColorValue;
    }

    private string LifecycleButtonText => Node.DisplayLifecycleState switch
    {
        ComponentLifecycleState.Starting => $"{Node.LifecycleLabel}...",
        ComponentLifecycleState.Failed => "Send",
        _ => "Send"
    };

    private string LifecycleButtonIcon => Icons.Material.Filled.Send;

    private MarkupString CardToolTipText { get; set; }
    private static string CardToolTipStyle => $"width: {Shared.CardWidth}px;";

    protected override void OnInitialized()
    {
        // Node.Dispatcher = Dispatcher;
    }

    private void DisableZoom()
    {
        Node.Diagram.Options.Zoom.Enabled = false;
    }

    private void EnableZoom()
    {
        Node.Diagram.Options.Zoom.Enabled = true;
    }

    private async Task SendIip()
    {
        await Node.SendIip(ConMan);
    }

    private async Task ShowDetails(MouseEventArgs e)
    {
        var parameters = new DialogParameters<TextEditorDialog>
        {
            { x => x.Text, Node.Content }
        };

        var dialog = await DialogService.ShowAsync<TextEditorDialog>("Edit IIP Content", parameters);
        var newContent = await dialog.GetReturnValueAsync<string>();
        if (newContent != null)
        {
            Node.Content = newContent;
        }
    }
}