@using Blazor.Diagrams.Core.Models.Base
;

<MudPaper Elevation="0" Class="mud-background-gray pa-2 rounded" Style="@($"width: {Link.Width}px;")">
    <MudText Typo="Typo.caption" Class="d-block">Width: @Link.Width</MudText>
    <MudText Typo="Typo.caption" Class="d-block">Color: @Link.Color</MudText>
    <MudText Typo="Typo.caption" Class="d-block">LLabel: @Link.Labels[0].Content</MudText>
    <MudText Typo="Typo.caption" Class="d-block">RLabel: @Link.Labels[1].Content</MudText>
</MudPaper>

@code
{
    [Parameter] [EditorRequired] public LinkInformationControl Control { get; set; } = null!;

    [Parameter] [EditorRequired] public Model Model { get; set; } = null!;

    public LinkModel Link => (Model as LinkModel)!;
}