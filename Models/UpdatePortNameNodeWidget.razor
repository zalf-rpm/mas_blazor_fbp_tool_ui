@using Blazor.Diagrams.Components.Renderers;
@using BlazorDrawFBP.Models;

<MudPaper Elevation="4" Class="pa-2 rounded" Style="width: 200px;">
    <MudTextField Required 
                  T="@string" 
                  @bind-Value="@Node.PortName"
                  AutoFocus="@true"
                  Label="@Node.Label" 
                  Variant="@Variant.Outlined"
                  OnBlur="@OnBlur"
                  OnKeyUp="@OnKeyUp"/>
</MudPaper>

@code {
    [Parameter, EditorRequired] public UpdatePortNameNode Node { get; set; } = null!;

    bool _alreadyRemoved = false;
    
    void OnBlur(FocusEventArgs e)
    {
        // Console.WriteLine("OnBlur");
        if (_alreadyRemoved) return;
        Node.PortModel.Name = Node.PortName;
        Node.PortModel.Refresh();
        if (Node.PortModel.Parent is CapnpFbpComponentModel component)
            component.QueueProcStructureSync();
        Node.Container.Nodes.Remove(Node);
    }

    void OnKeyUp(KeyboardEventArgs e)
    {
        // Console.WriteLine("OnKeyUp Enter pressed");
        if (e.Key != "Enter") return;
        Node.Container.Nodes.Remove(Node);
        Node.PortModel.Name = Node.PortName;
        Node.PortModel.Refresh();
        if (Node.PortModel.Parent is CapnpFbpComponentModel component)
            component.QueueProcStructureSync();
        _alreadyRemoved = true;
    }
}
