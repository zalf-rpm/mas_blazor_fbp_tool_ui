@using MudBlazor

<span style="@AnchorStyle">
    <MudTooltip Delay="200"
                Arrow="true"
                Placement="Placement.Bottom"
                Inline="true">
        <TooltipContent>
            <MudText Typo="Typo.body2" Style="@TooltipStyle">@ResolvedTooltipText</MudText>
        </TooltipContent>
        <ChildContent>
            <span class="lifecycle-indicator-dot" style="@IndicatorStyle"></span>
        </ChildContent>
    </MudTooltip>
</span>

@code {
    [Parameter] public ComponentLifecycleState State { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Error { get; set; } = "";
    [Parameter] public string TooltipText { get; set; } = "";
    [Parameter] public string Top { get; set; } = "0";
    [Parameter] public string Right { get; set; } = "0";

    private string ResolvedTooltipText =>
        !string.IsNullOrWhiteSpace(TooltipText)
            ? TooltipText
            : State == ComponentLifecycleState.Failed && !string.IsNullOrWhiteSpace(Error)
                ? $"{Label}: {Error}"
                : Label;

    private const string TooltipStyle =
        "white-space: pre-line; overflow-wrap: anywhere; max-width: 420px;";

    private string AnchorStyle =>
        $"position: absolute; right: {Right}; top: {Top}; transform: translate(50%, -50%); z-index: 2; display: inline-flex; line-height: 0;";

    private string IndicatorStyle =>
        $"--lifecycle-indicator-color: {CapnpFbpPortColors.ResolveLifecycleFrameColor(State)};";
}
