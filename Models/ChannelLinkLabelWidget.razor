@using Mas.Schema.Fbp
@if (Label?.ShowWidget == true)
{
    @* Compact label on the link. The expanded card is a control, see ChannelInfoCardControlWidget. *@
    <span class="d-inline-block" style="@CanvasStyle">
        <div class="d-inline-flex pa-1 channel-link-label__shell--compact"
             style="@CompactShellStyle"
             @onclick="Expand"
             @onclick:stopPropagation="true"
             @onpointerdown:stopPropagation="true">
            <MudTooltip Text="Click for channel details and buffer controls" Arrow="true" Inline="true">
                <MudPaper Class="d-flex flex-column pa-2"
                          Style="min-width: 5.75rem; max-width: 5.75rem;"
                          Elevation="2"
                          Outlined="true">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Storage"
                                 Size="Size.Small"
                                 Color="@BufferFillColor"/>
                        <MudText Color="Color.Secondary" Typo="Typo.caption">
                            Buffer
                        </MudText>
                    </div>
                    <MudText Align="Align.Center" Typo="Typo.subtitle2">
                        @BufferSummaryText
                    </MudText>
                    <MudProgressLinear Class="my-1"
                                       Rounded="true"
                                       Value="@QueueFillPercent"
                                       Color="@BufferFillColor"/>
                    <div class="d-flex mt-1 mud-text-secondary">
                        <span class="mr-2">W @Stats.NoOfWaitingWriters</span>
                        <span>R @Stats.NoOfWaitingReaders</span>
                    </div>
                </MudPaper>
            </MudTooltip>
        </div>
    </span>
}

@code
{
    private static readonly Channel<IP>.StatsCallback.Stats EmptyStats = new();

    [Parameter] [EditorRequired] public ChannelLinkLabelModel Label { get; set; } = null!;

    private Channel<IP>.StatsCallback.Stats Stats => Label?.Stats ?? EmptyStats;
    private string BufferSummaryText => Label?.BufferSummaryText ?? "";
    private double QueueFillPercent => Label?.QueueFillPercent ?? 0;
    private Color BufferFillColor => ChannelBufferColors.For(QueueFillPercent);

    private static readonly string CanvasStyle =
        $"position: relative; width: {ChannelLinkLabelModel.CompactInteractionCanvasWidth}px; height: {ChannelLinkLabelModel.CompactInteractionCanvasHeight}px; overflow: visible; pointer-events: none;";

    private const string ShellAnchorStyle = "position: absolute; left: 50%; top: 50%; pointer-events: auto;";
    private const string CompactShellStyle = $"{ShellAnchorStyle} cursor: pointer; user-select: none;";

    private void Expand()
    {
        Label?.Expand();
    }
}
