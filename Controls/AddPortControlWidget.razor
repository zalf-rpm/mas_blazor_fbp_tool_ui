@using Blazor.Diagrams.Core.Models.Base
<div>
    @if (Control.NodeModel?.Editable == true)
    {
        <MudFab Size="Size.Small"
                Color="Color.Success"
                StartIcon="@Icons.Material.Filled.Add"
                Label="@Control.Label"/>
    }
</div>

@code
{
    [Parameter] [EditorRequired] public AddPortControl Control { get; set; } = null!;

    [Parameter] [EditorRequired] public Model Model { get; set; } = null!;
}